{
  "name": "agents-kit-svelte",
  "version": "0.1.0",
  "description": "Svelte 5 Runes port of agents-ui/agents-kit & Trailside Dynamic Claude Code Chat Component",
  "license": "MIT",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5188",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4188",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "24.13.6",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "^4.1.7",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.svelte"
  ],
  "dependencies": {
    "@lucide/svelte": "^1.66.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
